{
  "name": "meet-to-notion",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch --import tsx/esm src/index.ts",
    "dev:tsx": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "trigger": "curl -X POST http://localhost:3000/cron/process -H \"Authorization: Bearer $CRON_SECRET\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.52.0",
    "@google/generative-ai": "^0.24.1",
    "@hono/node-server": "^1.13.7",
    "@notionhq/client": "^2.2.15",
    "dotenv": "^16.4.7",
    "hono": "^4.7.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
